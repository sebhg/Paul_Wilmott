<svg xmlns="http://www.w3.org/2000/svg" width="170" height="36" viewBox="0 0 170 36">
  <defs>
    <linearGradient id="bg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#008080"/>
      <stop offset="100%" stop-color="#47A141"/>
    </linearGradient>
    <linearGradient id="shine" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0"/>
      <stop offset="50%" stop-color="#FFFFFF" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#FFFFFF" stop-opacity="0"/>
    </linearGradient>
    <clipPath id="pill">
      <rect width="170" height="36" rx="18"/>
    </clipPath>
    <style>
      .label { font: 600 13px -apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif; fill: #FFFFFF; letter-spacing: 0.3px; }
      .shine { animation: sweep 4s ease-in-out 1s infinite; }
      .arrow { animation: nudge 4s ease-in-out 1s infinite; }
      @keyframes sweep { 0% { transform: translateX(0); } 30%,100% { transform: translateX(260px); } }
      @keyframes nudge { 0%,20%,100% { transform: translateX(0); } 10% { transform: translateX(3px); } }
    </style>
  </defs>

  <g clip-path="url(#pill)">
    <rect width="170" height="36" fill="url(#bg)"/>
    <rect width="170" height="18" fill="#FFFFFF" fill-opacity="0.08"/>
    <rect class="shine" x="-70" y="0" width="60" height="36" fill="url(#shine)" transform-origin="0 0"/>
  </g>

  <text class="label" x="22" y="22.5">Track progress</text>
  <g class="arrow">
    <path d="M134 18h14M142 12l6 6-6 6" fill="none" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
  </g>
</svg>
